# Copy to .env and fill in paths before running the server
# All paths are relative to the final/ directory unless absolute.

FINAL_DIR=../final
SPECTER_PATH=./outputs/embeddings/specter.npy
GNN_PATH=./outputs/embeddings/gnn_embeddings.pt
METADATA_PATH=./outputs/metadata/papers.parquet
DATASET_ROOT=./dataset

# Server settings
HOST=0.0.0.0
PORT=8000

# Query cache TTL in seconds (0 = disabled)
CACHE_TTL=300

# Maximum cached query results kept in memory
CACHE_MAX_SIZE=50

# Maximum query history kept for metrics
METRICS_HISTORY=500
